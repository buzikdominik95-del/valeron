# Скопировать в .env.local и поправить под своё окружение.
# Всё, что должно попасть в браузер, обязано начинаться с VITE_.

# Куда Vite проксирует /api, /sanctum и /broadcasting в dev-режиме.
# Локальный Laravel: http://localhost:8000
# Docker Compose:    http://nginx (имя сервиса из compose)
VITE_API_PROXY=http://localhost:8000

# Origin API. Пусто = тот же origin, что и фронт: в разработке запросы уходят
# через прокси Vite, и вопрос CORS не возникает вовсе.
# Для продакшена на поддомене: https://api.calipso-it.com
VITE_API_ORIGIN=

# Префикс API. Пустое значение трактуется как /api — путь без префикса
# прокси Vite не перехватывает.
VITE_API_BASE=/api

# --- Laravel Reverb (WebSocket) ---
# Совпадают с REVERB_* в .env Laravel 12 (PHP 8.4+).
# Broadcasting: redis; auth: Sanctum + /broadcasting/auth (прокси Vite есть).
# Docker: VITE_REVERB_HOST = имя сервиса reverb или публичный host Nginx.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# Стек бэкенда (ориентир, не читается Vite):
# Laravel 12 · PHP 8.4+ · PostgreSQL · Redis · Reverb · Docker Compose · Nginx

# Включить живой Laravel API (иначе Pinia-заглушки).
# VITE_USE_API=1
# VITE_API_PROXY=http://127.0.0.1:8000

# Панель L1–L4: при VITE_USE_API показывается сама. Явно:
# VITE_SHOW_PHASE_BAR=1
# VITE_HIDE_PHASE_BAR=1
